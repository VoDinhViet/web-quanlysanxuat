{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "google-sheets": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--with", "mcp<2", "mcp-google-sheets@latest"],
      "env": {
        "CREDENTIALS_PATH": "${HOME}/.config/mcp-google-sheets/credentials.json",
        "TOKEN_PATH": "${HOME}/.config/mcp-google-sheets/token.json"
      }
    }
  }
}
